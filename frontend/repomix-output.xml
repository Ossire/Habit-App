  padding: 1.5rem;
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 1.5rem;
}

.title-row h2 {
  font-size: 1.75rem;
  font-weight: 800;
  color: #000;
  margin: 0 0 0.25rem 0;
}

.category-badge {
  display: inline-block;
  font-size: 0.6rem;
  font-weight: 800;
  color: #000;
  border: 1px solid #000;
  padding: 2px 6px;
  text-transform: uppercase;
}

.habit-icon {
  width: 24px;
  height: 24px;
  color: #000;
}

/* Streak Box */
.streak-box {
  border: 1px solid #000;
  padding: 1.5rem;
  text-align: center;
  background-color: #fff;
  margin-bottom: 2rem;
}

.streak-number {
  display: block;
  font-size: 2.5rem;
  font-weight: 800;
  color: #000;
  line-height: 1;
  margin-bottom: 0.5rem;
}

.streak-label {
  font-size: 0.7rem;
  font-weight: 700;
  color: #666;
  letter-spacing: 1px;
}

/* Sections */
.section-block {
  margin-bottom: 2rem;
}

.section-title {
  font-size: 0.7rem;
  font-weight: 800;
  color: #111;
  border-bottom: 1px solid #ccc;
  padding-bottom: 0.5rem;
  margin-bottom: 1rem;
}

/* Activity Grid */
.activity-grid {
  display: flex;
  justify-content: space-between;
}

.day-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
}

.day-label {
  font-size: 0.6rem;
  font-weight: 800;
  color: #666;
}

.checkbox-square {
  width: 32px;
  height: 32px;
  border: 1px solid #000;
  background-color: #fff;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: all 0.2s;
}

.checkbox-square.checked {
  background-color: #000;
}

.checkbox-square svg {
  width: 18px;
  height: 18px;
}

/* Intake Chart */
.intake-chart {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 100px;
  margin-top: 2rem;
}

.chart-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  justify-content: flex-end;
  gap: 0.5rem;
}

.intake-bar {
  width: 20px;
  background-color: #eee; /* Very faint gray for the bars based on image space */
  border-radius: 2px 2px 0 0;
}

/* Insight Card & CTA */
.insight-card {
  border: 1px solid #000;
  background-color: #f9f9f9;
  margin-top: 3rem;
  display: flex;
  flex-direction: column;
}

.insight-text-area {
  padding: 1.25rem;
  display: flex;
  gap: 0.75rem;
}

.info-icon {
  width: 20px;
  height: 20px;
  color: #000;
  flex-shrink: 0;
}

.insight-text-area p {
  font-size: 0.8rem;
  color: #333;
  margin: 0;
  line-height: 1.4;
}

.btn-mark-done {
  width: 100%;
  background-color: #000;
  color: #fff;
  border: none;
  padding: 1rem;
  font-size: 0.9rem;
  font-weight: 800;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  transition: opacity 0.2s;
}

.btn-mark-done:hover {
  opacity: 0.9;
}

.btn-mark-done svg {
  width: 18px;
  height: 18px;
}

/* Bottom Nav */
.bottom-nav {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  border-top: 1px solid #000;
  display: flex;
